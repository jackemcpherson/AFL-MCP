{
  "name": "afl-mcp",
  "version": "5.0.1",
  "private": true,
  "imports": {
    "#test/*": "./test/support/*.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "vp check && bun run typecheck",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "format": "vp check --fix",
    "test": "node node_modules/vitest/vitest.mjs run",
    "db:migrate": "wrangler d1 migrations apply afl-stats",
    "check:schema": "python3 scripts/test_schema_parity.py && python3 scripts/verify_schema_parity.py"
  },
  "dependencies": {
    "effect": "4.0.4",
    "fitzroy": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@jackemcpherson/rds-js": "^0.3.0",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vite": "8.3.3",
    "vite-plus": "1.1.0",
    "vitest": "4.1.11",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": ">=7.28.0"
  }
}
