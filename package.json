{
  "name": "afl-mcp",
  "version": "5.0.1",
  "private": true,
  "imports": {
    "#test/*": "./test/support/*.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "vp check && bun run typecheck",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "format": "vp check --fix",
    "test": "vp test --run",
    "db:migrate": "wrangler d1 migrations apply afl-stats",
    "check:schema": "python3 scripts/test_schema_parity.py && python3 scripts/verify_schema_parity.py"
  },
  "dependencies": {
    "effect": "4.0.5",
    "fitzroy": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "@vitest/expect": "5.0.5",
    "@vitest/mocker": "5.0.5",
    "@vitest/pretty-format": "5.0.5",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "5.0.5",
    "@vitest/spy": "5.0.5",
    "@vitest/utils": "5.0.5",
    "undici": ">=7.28.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  }
}
